{
  "name": "pocketfund-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace packages/frontend",
    "build": "npm run build --workspace packages/frontend",
    "deploy": "npm run deploy --workspace packages/frontend",
    "migrate": "npm run migrate --workspace packages/backend",
    "typecheck": "npm run typecheck --workspace packages/backend",
    "test": "npm run test --workspace packages/backend"
  }
}
