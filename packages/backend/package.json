{
  "name": "pocketfund",
  "version": "0.1.0",
  "private": true,
  "description": "PocketFund API Worker (Hono on Cloudflare Workers)",
  "scripts": {
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "typecheck": "npm --prefix ../frontend run types && tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.18.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
